# Normalize line endings in the repo; check out native on Windows.
* text=auto

# Keep LF for files executed by a shell or an interpreter.
*.py  text eol=lf
*.sh  text eol=lf
*.svg text eol=lf

# Binary assets — never apply line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
